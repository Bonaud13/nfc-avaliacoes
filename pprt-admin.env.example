# Variáveis adicionais do painel administrativo
# Adicione em .env.local e também no Vercel > Settings > Environment Variables.

GITHUB_OWNER=Bonaud13
GITHUB_REPO=nfc-avaliacoes

# Opcional para repositório público, recomendado para aumentar limite da API.
# Nunca use NEXT_PUBLIC_ em token.
GITHUB_TOKEN=

# Site que será analisado pelo PageSpeed/Lighthouse.
NEXT_PUBLIC_SITE_URL=https://pprtia.vercel.app

# Opcional, recomendado para uso frequente do PageSpeed.
PAGESPEED_API_KEY=
